FLEXGATEWAY_BASE_URL=https://springboard-test.energydesk.no/flexibility/openadr3
# A local Flexgateway: http://localhost:8444/openadr3

# Use either a ready access token...
FLEXGATEWAY_ACCESS_TOKEN=

# ...or the OAuth 2 client credentials of your VEN client, issued by Flexgateway. The token URL is found
# automatically via GET /auth/server; set it only if you must override it.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPE=
# OAUTHCHECK_ACCESS_TOKEN_OBTAIN_URL=https://springboard-test.energydesk.no/flexibility/openadr3/auth/token

# Name for your ven, used only the first time (the client creates it if it does not exist).
FLEXGATEWAY_VEN_NAME=

# A secret of your own choosing, used for webhooks (sent when you subscribe, checked by your receiver).
WEBHOOK_BEARER_TOKEN=

# Operator (BL) client, used only by `enroll` (a VEN client cannot enroll itself). Create it under API access, kind BL.
OPERATOR_CLIENT_ID=
OPERATOR_CLIENT_SECRET=
